# ── Supabase ──
# Project Settings > API 에서 확인
NEXT_PUBLIC_SUPABASE_URL=
# anon 키: 브라우저에 노출돼도 안전하다 (RLS가 막아준다)
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# service_role 키: 절대 NEXT_PUBLIC_ 접두사를 붙이지 말 것.
# RLS를 우회하므로 노출되면 DB 전체가 열린다.
SUPABASE_SERVICE_ROLE_KEY=

# ── 메일 (Resend) ──
# resend.com 에서 발급. 디자이너 임시 비밀번호 안내 메일에 쓴다.
RESEND_API_KEY=
# 보내는 주소 — 도메인 인증을 마친 뒤에만 쓸 수 있다.
# 비워두면 onboarding@resend.dev 로 발송된다(본인 계정으로만 수신 가능).
MAIL_FROM_EMAIL=noreply@soom.it

# ── 관리 페이지 ──
# 구글 로그인 후 /admin 접근을 허용할 계정. 쉼표로 여러 개 가능.
# 비어 있으면 아무도 들어올 수 없다.
ADMIN_EMAILS=

# ── 사이트 주소 ──
# 디자이너 안내 메일의 로그인 링크에 쓰인다.
# 환경마다 달라야 한다 — 운영: https://soom.it
# 로컬은 비워두면 메일 링크가 요청 호스트로 만들어진다.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── 디자이너 세션 ──
# 로그인 쿠키 서명 키. 비워두면 SUPABASE_SERVICE_ROLE_KEY 에서 파생시킨다.
DESIGNER_SESSION_SECRET=
