# ── Supabase ──
# Project Settings > API 에서 확인
NEXT_PUBLIC_SUPABASE_URL=
# anon 키: 브라우저에 노출돼도 안전하다 (RLS가 막아준다)
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# service_role 키: 절대 NEXT_PUBLIC_ 접두사를 붙이지 말 것.
# RLS를 우회하므로 노출되면 DB 전체가 열린다.
SUPABASE_SERVICE_ROLE_KEY=

# ── 메일 (Resend) ──
# resend.com 에서 발급. 디자이너 임시 비밀번호 안내 메일에 쓴다.
RESEND_API_KEY=
# 보내는 주소 — 도메인 인증을 마친 뒤에만 쓸 수 있다.
# 비워두면 onboarding@resend.dev 로 발송된다(본인 계정으로만 수신 가능).
MAIL_FROM_EMAIL=noreply@soom.it

# ── 관리 페이지 ──
# 구글 로그인 후 /admin 접근을 허용할 계정. 쉼표로 여러 개 가능.
# 비어 있으면 아무도 들어올 수 없다.
ADMIN_EMAILS=

# ── 사이트 주소 ──
# 디자이너 안내 메일의 로그인 링크에 쓰인다.
# 환경마다 달라야 한다 — 운영: https://soom.it
# 로컬은 비워두면 메일 링크가 요청 호스트로 만들어진다.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── 문의 챗봇 (Claude) ──
# platform.claude.com 에서 발급. 비워두면 챗봇이 답하지 못하고,
# 어드민 → 문의 챗봇 화면에 설정하라는 줄이 뜬다.
# 지식은 DB(분야·플랜·FAQ·지식 카드)에서 읽으므로 키만 넣으면 된다.
ANTHROPIC_API_KEY=

# ── 디자이너 세션 ──
# 로그인 쿠키 서명 키. 비워두면 SUPABASE_SERVICE_ROLE_KEY 에서 파생시킨다.
DESIGNER_SESSION_SECRET=

# ── 결제 (페이업 표준결제) ──
# 결제 링크(/admin/payments → /pay/{token})에 쓴다. developers.payup.co.kr
# 가맹점 ID 와, "신용카드 API 결제" 오픈 때 메일로 오는 인증키(apiKey).
# test 모드는 standard.testpayup.co.kr 로 간다 — 개발자센터 예제의 테스트 계정
# (standard_test / d72a6a617ad84edcae59f7d0be8ed880)으로 흐름을 시험할 수 있다.
PAYUP_MODE=test
PAYUP_MERCHANT_ID=
PAYUP_API_KEY=
# 결제 완료 알림을 받을 주소(쉼표로 여러 개). 비우면 ADMIN_EMAILS 로 보낸다.
PAYMENT_NOTIFY_EMAILS=
